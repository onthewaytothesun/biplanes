server {
    listen 80;
    server_name biplanes.one-way.dev;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name biplanes.one-way.dev;

    ssl_certificate     /etc/ssl/one-way/fullchain.pem;
    ssl_certificate_key /etc/ssl/one-way/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    root  /var/www/biplanes;
    index index.html;

    gzip       on;
    gzip_types text/css application/javascript;

    # Имена файлов без хешей — браузер ревалидирует по ETag, после деплоя сразу видна новая версия
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Онлайн-бой: WebSocket (клиент пингует раз в 2 с, сервер рвёт соединение после 30 с тишины)
    location = /api/ws {
        proxy_pass            http://127.0.0.1:8093;
        proxy_http_version    1.1;
        proxy_set_header      Upgrade           $http_upgrade;
        proxy_set_header      Connection        "upgrade";
        proxy_set_header      Host              $host;
        proxy_set_header      X-Real-IP         $remote_addr;
        proxy_set_header      X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header      X-Forwarded-Proto $scheme;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;
        proxy_buffering       off;
    }

    # Бэкенд: вход через Telegram, матчи, рейтинг
    location /api/ {
        proxy_pass            http://127.0.0.1:8093;
        proxy_http_version    1.1;
        proxy_set_header      Connection "";
        proxy_set_header      Host              $host;
        proxy_set_header      X-Real-IP         $remote_addr;
        proxy_set_header      X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header      X-Forwarded-Proto $scheme;
        client_max_body_size  64k;
        proxy_read_timeout    15s;
    }

    # Webhook @BiplanesGameBot (проверка X-Telegram-Bot-Api-Secret-Token — в приложении)
    location = /tg/webhook {
        proxy_pass            http://127.0.0.1:8093;
        proxy_http_version    1.1;
        proxy_set_header      Connection "";
        proxy_set_header      Host              $host;
        proxy_set_header      X-Real-IP         $remote_addr;
        client_max_body_size  1m;
        proxy_read_timeout    30s;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\. {
        deny all;
    }
}
